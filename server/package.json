{
  "name": "snake-server",
  "version": "1.0.0",
  "private": true,
  "description": "Authoritative real-time game server for multiplayer Snake",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "test:clients": "node test/twoClients.js",
    "test:cheat": "node test/cheatClient.js",
    "test:reconnect": "node test/reconnect.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^3.3.7",
    "pg": "^8.23.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "socket.io-client": "^4.7.5"
  }
}
