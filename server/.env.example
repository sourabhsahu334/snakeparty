# Game server. Everything here is optional for local development — with none of
# it set the server runs, the game is fully playable, and you simply get no
# match history and no credit limit.

PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=*

# --------------------------------------------------------------- database --
# Postgres, running beside the server (see deploy/docker-compose.yml). Unset,
# the server logs a warning and skips all persistence.
DATABASE_URL=postgres://snake:password@localhost:5432/snake

# ------------------------------------------------------------------- auth --
# Signs the session JWTs the app carries. MUST be set in production: without it
# an ephemeral key is generated at boot, so every deploy signs everyone out.
#   openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL=30d

# The *web* OAuth client ID (Firebase project snakeparty-bf3af). This is the
# audience the server checks a Google ID token against — it must be the same
# value the app builds with as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID. Unset, Google
# sign-in is refused and everyone plays as a guest.
GOOGLE_WEB_CLIENT_ID=

# ---------------------------------------------------------------- credits --
# Free rooms each player may HOST per day. Joining someone else's room is always
# free, so this caps lobbies created, not time played.
FREE_ROOMS_PER_DAY=2
# Whose midnight the counter resets at. A UTC reset would land at 5:30am IST,
# which is fine, but the players are in India so the day boundary is theirs.
CREDITS_TIMEZONE=Asia/Kolkata

# ----------------------------------------------------------------- deploy --
# Read by deploy/deploy.sh and passed through to docker compose.
POSTGRES_PASSWORD=
