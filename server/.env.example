# Game server
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=*

# Supabase (optional locally — without these the server runs in guest-only mode)
# Use the SERVICE ROLE key here. It must never ship inside the mobile app, and
# must never be committed — put the real value in .env, which is gitignored.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
