# OSX
#
.DS_Store

# Android/IntelliJ
#
build/
.idea
.gradle
local.properties
*.iml
*.hprof
.cxx/

# Bundle artifacts
*.jsbundle

# Signing material — never commit. CI injects these from GitHub secrets
# (see .github/workflows/android-release.yml).
keystore.properties
*.jks

# Kotlin incremental-compile scratch
.kotlin/

# Firebase config. Not used at build time — there is no google-services plugin;
# the app reads the client ID from EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID. Kept out of
# the repo so its presence never implies otherwise.
google-services.json

# Play App Signing certificates, downloaded to read their SHA-1 fingerprints.
# Public certs, not secrets — but they belong in the Play Console, not here.
certificates*/
