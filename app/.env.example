# Where the game server lives — identity, match history and the game socket all
# live behind this one host now. Simulator/emulator can use localhost; a
# physical device needs your machine's LAN IP (e.g. http://192.168.1.20:3001) or
# the deployed URL. Restart `expo start` after changing this.
#
# Production: https://oracleserver2.neukaps.com
EXPO_PUBLIC_SERVER_URL=http://localhost:3001

# Google Sign-In (optional — without these the Google button is hidden and
# players sign in as guests). See docs/google-sign-in.md.
#
# The WEB client ID is what the server verifies the ID token against, so it is
# required on Android as well. None of these are secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-yyyyyyyy.apps.googleusercontent.com
# The iOS client ID reversed. Read by app.config.js at build time (not shipped
# in the bundle), and registered as the app's OAuth callback URL scheme.
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.1234567890-yyyyyyyy
